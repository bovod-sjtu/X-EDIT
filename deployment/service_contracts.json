[
  {
    "tool": "ace_step_music",
    "name": "ace_step_music",
    "url_env": "ACE_STEP_API_URL",
    "default_url": "http://127.0.0.1:8044",
    "command_env": "ACE_STEP_API_COMMAND",
    "command": [
      "bash",
      "-lc",
      "cd \"${ACE_STEP_REPO_DIR:?Set ACE_STEP_REPO_DIR to your installed ACE-Step checkout}\" && exec uv run acestep-api --host \"${ACE_STEP_API_HOST:-127.0.0.1}\" --port \"${ACE_STEP_API_PORT:-8044}\""
    ],
    "env": {
      "ACE_STEP_API_HOST": "127.0.0.1",
      "ACE_STEP_API_PORT": "8044",
      "ACESTEP_INIT_LLM": "false",
      "ACESTEP_SAVE_MEMORY": "1",
      "PYTORCH_CUDA_ALLOC_CONF": "expandable_segments:True",
      "UV_LINK_MODE": "copy"
    },
    "health_path": "/health",
    "smoke": [
      {
        "method": "OPTIONS",
        "path": "/release_task"
      },
      {
        "method": "OPTIONS",
        "path": "/query_result"
      }
    ],
    "startup_timeout_sec": 900,
    "setup_hint": "set ACE_STEP_REPO_DIR to an official ACE-Step checkout, or set ACE_STEP_API_COMMAND/ACE_STEP_API_URL"
  },
  {
    "tool": "auk",
    "name": "auk",
    "command_env": "AUK_SERVICE_COMMAND",
    "url_env": "AUK_SERVICE_URL",
    "default_url": "http://127.0.0.1:8065",
    "health_path": "/health",
    "startup_timeout_sec": 600,
    "setup_hint": "Start the run-owned AuK service with its frozen model assets and isolated environment; or supply AUK_SERVICE_COMMAND."
  },
  {
    "tool": "diarization",
    "name": "diarization",
    "url_env": "X_EDITOR_DIARIZATION_URL",
    "default_url": "http://127.0.0.1:8041",
    "command_env": "X_EDITOR_DIARIZATION_SERVICE_COMMAND",
    "command": [
      ".venv/bin/python",
      "service.py",
      "--host",
      "127.0.0.1",
      "--port",
      "8041"
    ],
    "env": {
      "TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD": "1"
    },
    "health_path": "/health",
    "smoke": [
      {
        "method": "OPTIONS",
        "path": "/diarize"
      }
    ],
    "startup_timeout_sec": 360,
    "setup_hint": "cd x_editor/tools/catalog/diarization && ./setup.sh"
  },
  {
    "tool": "edit_data_pipeline",
    "name": "dots_tts_edit",
    "when": {
      "argument": "operation",
      "values": [
        "text_edit",
        "pitch_rate_edit",
        "emotion_style_edit",
        "pause_edit"
      ],
      "environment": {
        "X_EDITOR_EDIT_BACKEND": {
          "default": "dots_tts_edit",
          "values": [
            "dots_tts_edit"
          ]
        }
      }
    },
    "url_env": "DOTS_TTS_EDIT_URL",
    "argument_url_key": "service_url",
    "default_url": "http://127.0.0.1:8049",
    "command_env": "DOTS_TTS_EDIT_SERVICE_COMMAND",
    "health_path": "/health",
    "smoke": [
      {
        "method": "OPTIONS",
        "path": "/execute"
      }
    ],
    "startup_timeout_sec": 900,
    "setup_hint": "请自行下载并安装 dots.tts.edit, then start your model service following docs/DOTS_TTS_EDIT.md; no source or weights are downloaded automatically."
  },
