      "lock": "deployment/requirements/model_server.lock",
      "metadata_exceptions": [
        {
          "pattern": "The package `compressed-tensors` requires `transformers<5\\.0\\.0`, but `5\\.5\\.0` is installed",
          "reason": "Verified original BF16 serving snapshot; no package/code substitution. Quantized compressed models remain unqualified."
        },
        {
          "pattern": "The package `vllm` requires `transformers>=4\\.56\\.0,<5`, but `5\\.5\\.0` is installed",
          "reason": "Verified original Qwen serving environment uses Transformers 5.5.0; retain exact versions and record this metadata incompatibility. New GPU host serving still requires actual inference qualification."
        }
      ]
    },
    "flexsed": {
      "python": "3.11.15",
      "lock": "deployment/requirements/flexsed.lock",
      "editable_sources": []
    },
