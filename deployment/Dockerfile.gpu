FROM nvidia/cuda:12.8.1-cudnn-devel-ubuntu22.04
WORKDIR /opt/xedit
COPY deployment/install_os.sh deployment/build_ffmpeg.sh deployment/check_ffmpeg.py /tmp/xedit-os/
RUN bash /tmp/xedit-os/install_os.sh && rm -rf /tmp/xedit-os
COPY . /opt/xedit
RUN uv sync --locked --no-dev
ENV PATH="/opt/xedit/.venv/bin:/opt/xedit-ffmpeg/bin:${PATH}"
# Mount a writable /data. Model/service environments are installed there.
# Inspect GPU placement before using all services; see docs/DEPLOYMENT.md.
ENTRYPOINT ["python", "deployment/bootstrap.py"]
CMD ["--data", "/data/xedit", "--phase", "plan", "all"]
