# Copy to .env and load explicitly with x-edit --env-file .env ...
# These defaults match configs/forward.json. Never add real tokens to this file.
XEDIT_PLANNER_URL=http://127.0.0.1:8040/v1
XEDIT_PLANNER_MODEL=Qwen/Qwen3.8-27B
XEDIT_REASONER_URL=http://127.0.0.1:8040/v1
XEDIT_REASONER_MODEL=Qwen/Qwen3.8-27B
XEDIT_PERCEPTION_URL=http://127.0.0.1:8011/v1
XEDIT_PERCEPTION_MODEL=Qwen3Omni-Instruct
XEDIT_SEMANTIC_JUDGE_URL=http://127.0.0.1:8040/v1
XEDIT_SEMANTIC_JUDGE_MODEL=Qwen/Qwen3.8-27B
XEDIT_AUDIO_JUDGE_URL=http://127.0.0.1:8011/v1
XEDIT_AUDIO_JUDGE_MODEL=Qwen3Omni-Instruct

# Each role can use its own model server URL; sharing URLs is optional.
# Lightweight clients have one uv environment each, separate from GPU services.
X_EDITOR_MCP_ENV_ROOT=/data/xedit/envs/clients

# All path-based tool services must see identical absolute input/output paths.
X_EDITOR_RUNTIME_ROOT=/data/xedit/runs
HF_HOME=/data/xedit/huggingface
HF_HUB_CACHE=/data/xedit/huggingface/hub
# For managed deployment, use the generated /data/xedit/client.env instead.
# For manual service deployment, set the actual source checkout location:
# EDIT_DATA_PIPELINE_ROOT=/absolute/path/to/x-edit/third_party/dots_tts_edit
EDIT_PIPELINE_ASR_URL=http://127.0.0.1:8010
EDIT_PIPELINE_ALIGNER_URL=http://127.0.0.1:8029
X_EDITOR_DIARIZATION_URL=http://127.0.0.1:8041
X_EDITOR_SEDICOW_URL=http://127.0.0.1:8046
X_EDITOR_MOSS_TRANSCRIBE_URL=http://127.0.0.1:8048
FLEXSED_SERVICE_URL=http://127.0.0.1:8057
SEED_VC_SERVICE_URL=http://127.0.0.1:8003
QWEN3_TTS_SERVICE_URL=http://127.0.0.1:8017
QWEN3_TTS_CLONE_SERVICE_URL=http://127.0.0.1:8019
EDIT_PIPELINE_QWEN3TTS_TOKENIZER_URL=http://127.0.0.1:8019
AUK_SERVICE_URL=http://127.0.0.1:8065
X_EDITOR_ENABLE_F5_TTS=0
F5_SERVICE_URL=
X_EDITOR_EDIT_BACKEND=dots_tts_edit
DOTS_TTS_EDIT_URL=http://127.0.0.1:8049

# Model/source paths are explicit; no sibling workspace auto-discovery.
# SEDICOW_REPO=/data/xedit/third_party/src/DiCoW
# SEDICOW_DICOW_MODEL=/data/xedit/models/SE-DiCoW
# MOSS_REPO=/data/xedit/third_party/src/MOSS-Transcribe-Diarize
# MOSS_MODEL_ID=/data/xedit/models/MOSS-Transcribe-Diarize
# FLEXSED_REPO_DIR=/data/xedit/third_party/src/FlexSED
# FLEXSED_CKPT_PATH=/data/xedit/models/flexsed.ckpt
# HF_TOKEN=

# Optional accent reference library; build your own outside the repository.
# See x_editor/accent_library/README.md (no reference recordings are bundled).
# X_EDITOR_ACCENT_LIBRARY_PATH=/data/my-accent-library/accent_library.jsonl

# Optional legacy Gemini gateway: explicit full generateContent URL; no private default.
# This client uses the api-key header (not the default Qwen/OpenAI-compatible stack).
# X_EDITOR_GEMINI_BASE_URL=
# GEMINI_API_KEY=
